{
  "name": "@andromeda/ui",
  "version": "0.2.0",
  "private": true,
  "description": "Дизайн-система Andromeda: токены, компоненты, тема. Исходники TypeScript — пакет собирается сборщиком хоста.",
  "type": "module",
  "main": "./index.ts",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.ts"
    },
    "./styles.css": "./styles.css",
    "./tokens": {
      "types": "./types/tokens/index.d.ts",
      "default": "./tokens/index.ts"
    },
    "./assets/*": "./assets/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  }
}
