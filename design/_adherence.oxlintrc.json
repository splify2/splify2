        "selector": "JSXOpeningElement[name.name='BarSeries'] > JSXAttribute[name.name='fill'] > Literal[value!=/^(?:solid|half|ghost)$/]",
        "message": "<BarSeries> fill must be one of 'solid' | 'half' | 'ghost'."
      },
      {
