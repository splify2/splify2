#!/usr/bin/ucode
// API splify2 — HTTP-шлюз к ubus-объекту splify2 для приложений вне LuCI (описание — SPLIFY2_API.md
// в хабе splicicd; в документацию для людей войдёт с выпуском 26.11).
//
// ЗАЧЕМ ОТДЕЛЬНЫЙ ВХОД, А НЕ /ubus. Сессия ubus живёт пять минут без обращений и пропадает с
// перезагрузкой роутера: приложение на компьютере просило бы пароль root снова и снова. Здесь
// пароль спрашивается ОДИН раз — при подключении устройства, — а дальше устройство живёт на паре
// токенов: короткий токен доступа и долгий токен обновления, который меняется при каждом
// обновлении. Устройство можно отключить, не трогая пароль.
//
// ЧТО ВНУТРИ ВЫЗОВА. Тот же ubus-объект splify2, что зовёт панель LuCI, — через локальный ubus от
// root. Сигнатуры, приведение типов и набор методов остаются у rpcd; своей модели здесь нет.
//
// ДОЛГИЕ ВЫЗОВЫ — ЗАДАНИЕМ, ПО ПРОСЬБЕ КЛИЕНТА. uhttpd обрывает CGI ровно через script_timeout
// (60 с по умолчанию; вывод порциями предел не продлевает — проверено на стенде), а rpcd ждёт
// обработчик до 120 с. Тот же предел у панели LuCI: uhttpd-mod-ubus берёт тайм-аут оттуда же.
// Обычный вызов идёт прямо здесь — так он стоит столько же, сколько у панели (задание через
// отдельный процесс прибавляло ~130 мс на стенде). Вызов с ?async=1 выполняет отдельный процесс
// (этот же файл с ключом --job): шлюз ждёт его до WAIT секунд, не дождался — отдаёт 202 с номером
// задания, и клиент дочитывает ответ по /v1/jobs/<id>.
'use strict';

import * as fs from 'fs';
import * as ubus from 'ubus';

const API = 1;
const VERSION = '@VERSION@';

// Устройства — во флеше: переживают перезагрузку и sysupgrade (lib/upgrade/keep.d/splify2).
// Токены доступа и задания — в памяти: после перезагрузки токен доступа обновляется сам.
const ETC = '/etc/splify2/api';
const DEV = ETC + '/devices';
const RUN = '/tmp/splify2-api';
const ACC = RUN + '/access';
const JOBS = RUN + '/jobs';
const FAILS = RUN + '/fails.json';

// Бинарник ядра (подписка на события).
const STEER_BIN = '/usr/sbin/steer';

// Час, а не минуты: каждое обновление переписывает файл устройства во флеше. Час — 24 записи в
// сутки на устройство, а не сотня.
const ACCESS_TTL = 3600;
// Устройство, которое не обновляло токен 90 дней, забывается.
const IDLE_TTL = 90 * 86400;
// Прежний токен обновления годен ещё минуту после смены: ответ на обновление мог потеряться в
// сети, и клиент вправе повторить. Позже прежний токен — признак кражи: устройство отключается.
const GRACE = 60;
// Сколько ждать ответа задания до 202 и прямого вызова до 504. Запас до 60 с uhttpd — на запуск
// и запись ответа.
const WAIT = 45;
const JOB_KEEP = 600;
const BODY_MAX = 4 * 1024 * 1024;
// Пять неверных паролей с одного адреса за пять минут — пауза для этого адреса до конца окна.
const FAIL_MAX = 5;
const FAIL_WINDOW = 300;

const SELF = sourcepath() ?? '/www/cgi-bin/splify2-api';

const STATUS_TEXT = {
	'200': 'OK', '202': 'Accepted', '400': 'Bad Request', '401': 'Unauthorized',
	'403': 'Forbidden', '404': 'Not Found', '405': 'Method Not Allowed', '409': 'Conflict',
	'413': 'Payload Too Large', '429': 'Too Many Requests', '500': 'Internal Server Error',
	'502': 'Bad Gateway', '504': 'Gateway Timeout',
};

function reply(code, body) {
	print(`Status: ${code} ${STATUS_TEXT[code] ?? ''}\r\n`,
		'Content-Type: application/json\r\n',
		'Cache-Control: no-store\r\n\r\n',
		sprintf('%J', body), '\n');
	exit(0);
}

// ── Тексты отказов ──────────────────────────────────────────────────────────
//
// Шлюз говорит по-английски, переводят языковые плагины (как бэкенд: files/usr/lib/splify2/i18n.sh). Отказ — это
// машинное слово `error` (его знают клиенты), КОД текста `code` вида `gateway.<ключ>`, значения подстановок `args` и
// `message` — текст на языке каркаса. Текст по коду берётся из i18n/backend/<язык>.json ВКЛЮЧЁННЫХ плагинов (плоский
// объект «код» -> текст с {имя}); нет словаря или кода в нём — английский текст из TEXTS. Клиент вправе перевести сам
// по `code` и `args`. Язык — S2_LANG, иначе luci.main.lang; «auto» шлюз не различает — английский.
const TEXTS = {
	too_large: 'Request too large',
	bad_json: 'The request body is not JSON',
	bad_json_object: 'The request body is not a JSON object',
	no_token: 'An access token is required',
	bad_token: 'Access token not found',
	token_expired: 'The access token has expired',
	revoked: 'The device is disconnected',
	revoked_idle: 'The device has not connected for a long time and is disconnected',
	revoked_reuse: 'The refresh token was used twice: the device is disconnected',
	refresh_unknown: 'Refresh token not recognised',
	refresh_mismatch: 'The refresh token does not match',
	too_many_attempts: 'Too many wrong passwords, try again later',
	login_needs_credentials: 'A user name and a password are required',
	login_needs_device_name: 'A device name of up to 64 characters is required',
	bad_password: 'Wrong user name or password',
	account_forbidden: 'This account has no access to splify2',
	no_method: 'No such method',
	no_ubus: 'ubus is unavailable',
	no_object: 'The splify2 object is not found in ubus',
	bad_args: 'Invalid arguments',
	denied: 'Access denied',
	timeout: 'The handler did not answer',
	backend_error: '{error}',
	no_job: 'No such job',
	batch_needs_calls: 'A list of calls is required',
	bad_verb: '{verb} is required',
	bad_verb_get_post: 'GET or POST is required',
	no_device: 'No such device',
	no_route: 'No such address',
};

function read_json(path) {
	let s = fs.readfile(path);
	if (s == null) return null;
	try { return json(s); } catch (e) { return null; }
}

let LANG;
function lang() {
	if (LANG != null) return LANG;
	let l = getenv('S2_LANG');
	if (!l) {
		try { l = require('uci').cursor().get('luci', 'main', 'lang'); } catch (e) { l = null; }
	}
	l = replace(lc(l ?? 'en'), '_', '-');
	LANG = (!match(l, /^[a-z0-9-]+$/) || l == 'auto') ? 'en' : l;
	return LANG;
}

function dict_text(code) {
	let root = getenv('PLUGIN_ROOT') ?? '/usr/lib/steer/plugins';
	let state = read_json(getenv('PLUGIN_STATE') ?? '/etc/steer/plugins/state.json');
	let l = lang();
	for (let lg in (index(l, '-') > 0 ? [l, split(l, '-')[0]] : [l])) {
		let files = [];
		for (let id in fs.lsdir(root) ?? []) {
			if (state?.plugins?.[id]?.state == 'enabled')
				push(files, `${root}/${id}/i18n/backend/${lg}.json`);
		}
		let extra = getenv('S2_DICT_EXTRA');
		if (extra) push(files, `${extra}/${lg}.json`);
		for (let f in files) {
			let t = read_json(f)?.[code];
			if (type(t) == 'string' && t != '') return t;
		}
	}
	return null;
}

// {имя} -> значение за один проход: подставленное значение заново не разбирается.
function subst(text, args) {
	return replace(text, /\{([A-Za-z0-9_]+)\}/g, (m, n) => args?.[n] != null ? '' + args[n] : m);
}

// Поля отказа: message, code, args.
function refusal(key, args) {
	let code = `gateway.${key}`;
	return { message: subst(dict_text(code) ?? TEXTS[key] ?? key, args), code, args: args ?? {} };
}

// fail(HTTP-статус, error, ключ текста, подстановки, добавочные поля, готовый текст). Готовый текст — ответ плагина,
// уже на языке каркаса (отказ метода плагина): code в extra — его собственное слово.
function fail(status, id, key, args, extra, text) {
	let b = { error: id };
	if (text != null) b.message = text;
	else for (let k, v in refusal(key, args)) b[k] = v;
	for (let k, v in extra) b[k] = v;
	reply(status, b);
}

function mkdirs(path) {
	let p = '';
	for (let part in split(path, '/')) {
		if (part == '') continue;
		p += '/' + part;
		if (!fs.stat(p))
			fs.mkdir(p, 0700);
	}
}

function rand_hex(n) {
	return hexenc(fs.readfile('/dev/urandom', n));
}

// Вход — только [0-9a-f], его проверяет вызывающий: строка уходит в оболочку.
function sha256(hex) {
	let p = fs.popen(`printf %s ${hex} | sha256sum`, 'r');
	let out = p.read('all');
	p.close();
	return substr(out, 0, 64);
}

function write_json(path, v) {
	fs.writefile(path + '.tmp', sprintf('%J', v));
	fs.chmod(path + '.tmp', 0600);
	fs.rename(path + '.tmp', path);
}

function read_body() {
	let n = +(getenv('CONTENT_LENGTH') ?? 0);
	if (n > BODY_MAX) fail(413, 'too_large', 'too_large');
	if (!n) return {};
	let s = '';
	while (length(s) < n) {
		let c = fs.stdin.read(n - length(s));
		if (c == null || c == '') break;
		s += c;
	}
	let v;
	try { v = json(s); } catch (e) { fail(400, 'bad_json', 'bad_json'); }
	if (type(v) != 'object') fail(400, 'bad_json', 'bad_json_object');
	return v;
}

// ── Устройства ──────────────────────────────────────────────────────────────

function dev_path(id) { return `${DEV}/${id}.json`; }

function dev_load(id) {
	if (type(id) != 'string' || !match(id, /^[0-9a-f]{16}$/)) return null;
	return read_json(dev_path(id));
}

function dev_save(d) {
	mkdirs(DEV);
	write_json(dev_path(d.id), d);
}

function dev_forget(id) {
	fs.unlink(dev_path(id));
	for (let f in fs.lsdir(ACC) ?? []) {
		let a = read_json(`${ACC}/${f}`);
		if (!a || a.dev == id) fs.unlink(`${ACC}/${f}`);
	}
}

function sweep_access() {
	let now = time();
	for (let f in fs.lsdir(ACC) ?? []) {
		let a = read_json(`${ACC}/${f}`);
		if (!a || a.exp <= now) fs.unlink(`${ACC}/${f}`);
	}
}

function client_ip() { return getenv('REMOTE_ADDR') ?? ''; }

// Новая пара токенов. Токен обновления хранится только хешем: в файле устройства его не
// прочитать, даже если файл уехал в чужие руки.
function issue(d) {
	mkdirs(ACC);
	sweep_access();
	let secret = rand_hex(32);
	let access = 'sa_' + rand_hex(32);
	let now = time();
	if (d.hash) {
		d.prev = d.hash;
		d.prev_until = now + GRACE;
	}
	d.hash = sha256(secret);
	d.seen = now;
	d.ip = client_ip();
	dev_save(d);
	write_json(`${ACC}/${access}`, { dev: d.id, exp: now + ACCESS_TTL });
	return {
		access_token: access,
		token_type: 'Bearer',
		expires_in: ACCESS_TTL,
		refresh_token: `sr_${d.id}.${secret}`,
		device: { id: d.id, name: d.name },
	};
}

// Устройство по токену доступа или 401. Отключённое устройство теряет и токены доступа сразу:
// файл устройства проверяется на каждом вызове, а это один stat.
function authorize() {
	let m = match(getenv('HTTP_AUTHORIZATION') ?? '', /^Bearer (sa_[0-9a-f]{64})$/);
	if (!m) fail(401, 'no_token', 'no_token');
	let path = `${ACC}/${m[1]}`;
	let a = read_json(path);
	if (!a) fail(401, 'bad_token', 'bad_token');
	if (a.exp <= time()) {
		fs.unlink(path);
		fail(401, 'token_expired', 'token_expired');
	}
	if (!fs.access(dev_path(a.dev))) {
		fs.unlink(path);
		fail(401, 'revoked', 'revoked');
	}
	return a.dev;
}

function dev_public(d, me) {
	return {
		id: d.id, name: d.name, platform: d.platform, created: d.created,
		seen: d.seen, ip: d.ip, current: d.id == me,
	};
}

// ── Вход ────────────────────────────────────────────────────────────────────

// Счёт неверных паролей — по адресу, а не общий: общий давал бы любому в сети запереть вход
// владельцу пятью неверными паролями.
function fails_load() {
	let now = time(), all = read_json(FAILS), out = {};
	if (type(all) != 'object') return out;
	for (let ip, list in all) {
		if (type(list) != 'array') continue;
		let keep = filter(list, (t) => type(t) == 'int' && now - t < FAIL_WINDOW);
		if (length(keep)) out[ip] = keep;
	}
	return out;
}

function login(b) {
	let fails = fails_load();
	let recent = fails[client_ip()] ?? [];
	if (length(recent) >= FAIL_MAX)
		fail(429, 'too_many_attempts', 'too_many_attempts', null,
			{ retry_after: FAIL_WINDOW - (time() - recent[0]) });

	let user = b.username ?? 'root';
	let name = b.device_name;
	if (type(user) != 'string' || type(b.password) != 'string')
		fail(400, 'bad_request', 'login_needs_credentials');
	if (type(name) != 'string' || length(name) == 0 || length(name) > 64)
		fail(400, 'bad_request', 'login_needs_device_name');

	// Пароль проверяет сам rpcd — те же учётные записи и то же правило, что у входа в LuCI.
	let c = ubus.connect();
	let s = c.call('session', 'login', { username: user, password: b.password, timeout: 30 });
	if (!s?.ubus_rpc_session) {
		mkdirs(RUN);
		push(recent, time());
		fails[client_ip()] = recent;
		write_json(FAILS, fails);
		sleep(1000);
		fail(401, 'bad_password', 'bad_password');
	}
	// Вход в LuCI ещё не значит права на splify2: у учётной записи только для чтения их нет, а
	// вызовы шлюза идут от root. Пускаем только тех, кому панель разрешила бы запись.
	let acc = c.call('session', 'access', {
		ubus_rpc_session: s.ubus_rpc_session, scope: 'ubus', object: 'splify2', 'function': 'spec_set',
	});
	c.call('session', 'destroy', { ubus_rpc_session: s.ubus_rpc_session });
	if (!acc?.access)
		fail(403, 'forbidden', 'account_forbidden');

	let d = {
		id: rand_hex(8), name, platform: type(b.platform) == 'string' ? substr(b.platform, 0, 32) : '',
		user, created: time(),
	};
	reply(200, issue(d));
}

// Замок обновления токена живёт до конца процесса: reply и fail завершают его (exit), и файл
// замка закрывается вместе с ним.
let refresh_lock;

function refresh(b) {
	let m = match(b.refresh_token ?? '', /^sr_([0-9a-f]{16})\.([0-9a-f]{64})$/);
	if (!m) fail(401, 'bad_token', 'refresh_unknown');
	// Два одновременных обновления одним токеном (повтор клиента, два окна) читали бы один и тот же
	// файл устройства, и каждое выдало бы свой секрет: выигрывал последний записавший, а другой
	// клиент оставался с токеном, который уже «прежний». С замком второй приходит после первого и
	// попадает в окно повтора (GRACE) — как и задумано.
	mkdirs(RUN);
	refresh_lock = fs.open(`${RUN}/refresh-${m[1]}.lock`, 'w', 0600);
	if (refresh_lock) refresh_lock.lock('x');
	let d = dev_load(m[1]);
	if (!d) fail(401, 'revoked', 'revoked');
	let now = time();
	if (now - d.seen > IDLE_TTL) {
		dev_forget(d.id);
		fail(401, 'revoked', 'revoked_idle');
	}
	let h = sha256(m[2]);
	if (h == d.hash || (h == d.prev && now <= d.prev_until))
		reply(200, issue(d));
	if (h == d.prev) {
		// Прежний токен после окна повтора: им уже кто-то воспользовался.
		dev_forget(d.id);
		fail(401, 'revoked', 'revoked_reuse');
	}
	fail(401, 'bad_token', 'refresh_mismatch');
}

// ── Вызовы ──────────────────────────────────────────────────────────────────

// Статус ubus приходит только строкой ubus.error() — числового кода привязка не отдаёт.
function ubus_fail(err) {
	err ??= '';
	if (index(err, 'Method not found') == 0) return [404, 'no_method', 'no_method'];
	if (index(err, 'Not found') == 0) return [502, 'no_backend', 'no_object'];
	if (index(err, 'Invalid argument') == 0) return [400, 'bad_args', 'bad_args'];
	if (index(err, 'Permission denied') == 0) return [403, 'forbidden', 'denied'];
	if (index(err, 'Request timed out') == 0) return [504, 'timeout', 'timeout'];
	return [502, 'backend_error', 'backend_error', { error: err }];
}

function sweep_jobs() {
	let now = time();
	for (let j in fs.lsdir(JOBS) ?? []) {
		let st = fs.stat(`${JOBS}/${j}`);
		if (st && now - st.mtime > JOB_KEEP) {
			for (let f in fs.lsdir(`${JOBS}/${j}`) ?? []) fs.unlink(`${JOBS}/${j}/${f}`);
			fs.rmdir(`${JOBS}/${j}`);
		}
	}
}

function job_drop(dir) {
	for (let f in fs.lsdir(dir) ?? []) fs.unlink(`${dir}/${f}`);
	fs.rmdir(dir);
}

// Ответ метода клиенту. Объект splify2 отдаёт отказ УСПЕШНЫМ вызовом ({ok: false, error}) — так
// принято у всех его методов, и шлюз это не меняет. Исключение — вызов метода плагина (plugin_call):
// у него отказ несёт слово code (not_installed, disabled, no_method…), и клиенту приложения проще
// получить его статусом HTTP, чем разбирать тело. Ответ самого плагина с ok: false, но без code
// (его собственная логика) идёт как есть.
const PLUGIN_STATUS = {
	bad_request: 400, not_installed: 404, no_method: 404, disabled: 409, unavailable: 409,
	busy: 409, timeout: 504, failed: 500,
};

function result_reply(res, method) {
	if (method == 'plugin_call' && res?.ok === false && PLUGIN_STATUS[res.code])
		fail(PLUGIN_STATUS[res.code], res.code, null, null, { code: res.code }, res.error ?? '');
	reply(200, res);
}

// Ждать ответа задания до WAIT секунд. Опрос файла с растущим шагом: короткий вызов (состояние,
// спека) отвечает за десятки миллисекунд, и первые проверки идут часто.
function job_wait(id, dir) {
	let until = time() + WAIT, step = 10;
	while (true) {
		let out = read_json(`${dir}/out`);
		if (out) {
			let req = read_json(`${dir}/in`);
			job_drop(dir);
			if (out.error) {
				let f = ubus_fail(out.error);
				fail(f[0], f[1], f[2], f[3]);
			}
			result_reply(out.result ?? {}, req?.method);
		}
		if (time() >= until) break;
		sleep(step);
		if (step < 100) step *= 2;
	}
	reply(202, { job: id, poll: `/v1/jobs/${id}` });
}

function call(dev, method, args, async) {
	if (!match(method, /^[a-z][a-z0-9_]{0,63}$/)) fail(404, 'no_method', 'no_method');
	if (!async) {
		let c = ubus.connect(null, WAIT);
		if (!c) fail(502, 'no_backend', 'no_ubus');
		let res = c.call('splify2', method, args);
		let err = ubus.error();
		if (err) {
			let f = ubus_fail(err);
			fail(f[0], f[1], f[2], f[3]);
		}
		result_reply(res ?? {}, method);
	}
	mkdirs(JOBS);
	sweep_jobs();
	let id = rand_hex(8), dir = `${JOBS}/${id}`;
	fs.mkdir(dir, 0700);
	write_json(`${dir}/in`, { dev, method, args });
	// Свой сеанс (setsid) и закрытые потоки: задание не держит трубу uhttpd и переживает
	// выход шлюза. Аргументы — только наш путь и шестнадцатеричный номер.
	system(`setsid ${SELF} --job ${id} </dev/null >/dev/null 2>&1 &`);
	job_wait(id, dir);
}

function job_poll(dev, id) {
	if (!match(id, /^[0-9a-f]{16}$/)) fail(404, 'no_job', 'no_job');
	let dir = `${JOBS}/${id}`;
	let req = read_json(`${dir}/in`);
	if (!req || req.dev != dev) fail(404, 'no_job', 'no_job');
	job_wait(id, dir);
}

// Исполнитель задания: один вызов ubus и ответ файлом. Срок — больше, чем ждёт сам rpcd (120 с).
function run_job(id) {
	if (!match(id ?? '', /^[0-9a-f]{16}$/)) exit(1);
	let dir = `${JOBS}/${id}`;
	let req = read_json(`${dir}/in`);
	if (!req) exit(1);
	let c = ubus.connect(null, 150);
	let res = c ? c.call('splify2', req.method, type(req.args) == 'object' ? req.args : {}) : null;
	let err = c ? ubus.error() : 'Not found: ubus';
	write_json(`${dir}/out`, err ? { error: err } : { result: res });
	exit(0);
}

// ── Пакет вызовов и события ядра (приложение для ПК) ────────────────────────

// Несколько методов одним запросом: один процесс шлюза и одно соединение ubus вместо стольких,
// сколько вызовов. Приложение собирает в пакет вызовы, ушедшие одновременно (открытие раздела —
// спека, применённая спека, подписки, устройства, каталог…). Долгие методы — не сюда: им нужен
// ?async=1 и задание. Ответ — по вызову, в том же порядке: `{ok: true, result}` или
// `{ok: false, status, error, message}` — отказ одного не роняет остальные.
function batch(b) {
	if (type(b?.calls) != 'array') fail(400, 'bad_request', 'batch_needs_calls');
	let c = ubus.connect(null, WAIT);
	if (!c) fail(502, 'no_backend', 'no_ubus');
	let out = [];
	for (let x in b.calls) {
		let name = x?.method;
		if (type(name) != 'string' || !match(name, /^[a-z][a-z0-9_]{0,63}$/)) {
			push(out, { ok: false, status: 404, error: 'no_method', ...refusal('no_method') });
			continue;
		}
		let res = c.call('splify2', name, type(x.params) == 'object' ? x.params : {});
		let err = ubus.error();
		if (err) {
			let f = ubus_fail(err);
			push(out, { ok: false, status: f[0], error: f[1], ...refusal(f[2], f[3]) });
		}
		else
			push(out, { ok: true, result: res ?? {} });
	}
	reply(200, { results: out });
}

// События ядра длинным запросом: подписка демона (`steer subscribe`, steer docs/ctl.md) до первого
// события или до EVENT_WAIT секунд — и ответ. Приложение по событию сразу перечитывает состояние, а
// сторож — уведомляет: выход переключился, отказал, ожил, помощник упал, спека применена. Без этого
// о падении выхода узнавали только следующим опросом.
//
// Срок — свой сторож в оболочке (`timeout` на роутере нет): спящий подпроцесс гасит подписку. По
// событию гасятся оба, сначала сторож — чтобы его `kill` не попал в чужой процесс с тем же номером.
const EVENT_WAIT = 25;

function events() {
	let p = fs.popen(`sh -c 'echo $$; (sleep ${EVENT_WAIT}; kill $$) & echo $!; exec ${STEER_BIN} subscribe 2>&1'`, 'r');
	if (!p) reply(200, { events: [], unsupported: true });
	let pid = int(trim(p.read('line') ?? ''));
	let dog = int(trim(p.read('line') ?? ''));
	let got = [], ok = false;
	for (let line = p.read('line'); line != null && length(line) > 0; line = p.read('line')) {
		let j = null;
		try { j = json(line); } catch (e) { j = null; }
		if (type(j) != 'object') continue;
		if (j.cmd == 'subscribe') { ok = (j.code == 0); continue; }
		if (j.ev) { push(got, j); break; }
	}
	if (dog > 0) system(`kill ${dog} 2>/dev/null`);
	if (pid > 0) system(`kill ${pid} 2>/dev/null`);
	p.close();
	reply(200, ok ? { events: got } : { events: [], unsupported: true });
}

// ── Плагины ─────────────────────────────────────────────────────────────────

// Метод самого плагина: тот же диспетчер, что у объекта ubus splify2.p.<id> в LuCI (plugin_invoke в
// /usr/lib/splify2/plugin.sh), но через метод plugin_call объекта splify2 — у шлюза нет сессии ubus
// для объекта плагина, а его вызовы идут от root. Тело запроса — параметры метода (объект JSON), ответ —
// ответ плагина. Отказ приходит статусом HTTP (см. PLUGIN_STATUS): плагин не установлен — 404, выключен
// — 409, метода нет — 404, срок вышел — 504. Метод с `job: true` отвечает {job}, итог — вызовом
// POST /v1/call/plugin_job {id}. Долгий метод — с ?async=1, как любой другой вызов.
function plugin_route(id, name, async) {
	let me = authorize();
	let body = method == 'POST' ? read_body() : {};
	call(me, 'plugin_call', { id, method: name, params: body }, async);
}

// ── Разбор запроса ──────────────────────────────────────────────────────────

if (ARGV[0] == '--job')
	run_job(ARGV[1]);

const method = getenv('REQUEST_METHOD') ?? 'GET';
const path = getenv('PATH_INFO') ?? '/';
let m;

function only(verb) {
	if (method != verb) fail(405, 'bad_verb', 'bad_verb', { verb });
}

if (path == '/v1/info' || path == '/v1' || path == '/') {
	only('GET');
	reply(200, {
		product: 'splify2', api: API, version: VERSION,
		hostname: trim(fs.readfile('/proc/sys/kernel/hostname') ?? ''),
		auth: ['password'],
	});
}
else if (path == '/v1/auth/login') {
	only('POST');
	login(read_body());
}
else if (path == '/v1/auth/refresh') {
	only('POST');
	refresh(read_body());
}
else if (path == '/v1/auth/logout') {
	only('POST');
	let me = authorize();
	dev_forget(me);
	reply(200, { ok: true });
}
else if (path == '/v1/devices') {
	only('GET');
	let me = authorize();
	let list = [];
	for (let f in fs.lsdir(DEV) ?? []) {
		let d = read_json(`${DEV}/${f}`);
		if (d?.id) push(list, dev_public(d, me));
	}
	reply(200, { devices: sort(list, (a, b) => b.seen - a.seen) });
}
else if ((m = match(path, /^\/v1\/devices\/([0-9a-f]{16})\/revoke$/))) {
	only('POST');
	authorize();
	if (!dev_load(m[1])) fail(404, 'no_device', 'no_device');
	dev_forget(m[1]);
	reply(200, { ok: true });
}
else if ((m = match(path, /^\/v1\/call\/([^\/]+)$/))) {
	only('POST');
	let me = authorize();
	call(me, m[1], read_body(), match(getenv('QUERY_STRING') ?? '', /(^|&)async=1(&|$)/) != null);
}
else if (path == '/v1/batch') {
	only('POST');
	authorize();
	batch(read_body());
}
else if (path == '/v1/events') {
	only('GET');
	authorize();
	events();
}
else if ((m = match(path, /^\/v1\/jobs\/([^\/]+)$/))) {
	only('GET');
	job_poll(authorize(), m[1]);
}
else if ((m = match(path, /^\/v1\/plugin\/([a-z0-9][a-z0-9-]*)\/([a-z][a-z0-9_]*)$/))) {
	if (method != 'GET' && method != 'POST') fail(405, 'bad_verb', 'bad_verb_get_post');
	plugin_route(m[1], m[2], match(getenv('QUERY_STRING') ?? '', /(^|&)async=1(&|$)/) != null);
}
else
	fail(404, 'no_route', 'no_route');
