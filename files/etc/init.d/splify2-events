#!/bin/sh /etc/rc.common
# Раздача событий ядра плагинам splify2 (одна подписка на роутер). Включает и выключает её plugin_sync по
# наличию у плагинов `splify2.events`; сама служба ничего не решает.
USE_PROCD=1
START=97
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/splify2-events
    procd_set_param respawn
    procd_close_instance
}
