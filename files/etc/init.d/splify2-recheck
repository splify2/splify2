#!/bin/sh /etc/rc.common
# ReCheck — обход DPI на прямом трафике (самостоятельная часть splify2, см. /usr/lib/splify2/recheck.sh).
# Включается настройкой enabled=1 в /etc/splify2/recheck.conf; без движка (пакет recheck) — не
# запускается и правил не ставит.

START=96
STOP=10
USE_PROCD=1

. "${RECHECK_SH:-/usr/lib/splify2/recheck.sh}"

start_service() {
    [ "$(recheck_get enabled 0)" = 1 ] || { recheck_drop; return 0; }
    [ -x "$RECHECK_BIN" ] || { recheck_drop; return 0; }
    wan="$(recheck_wan)"
    [ -n "$wan" ] || { logger -t splify2-recheck "no WAN - not starting"; recheck_drop; return 0; }
    # shellcheck disable=SC2046
    recheck_nft "$wan" $(recheck_lan) > /tmp/splify2-recheck.nft &&
        { nft delete table inet "$RECHECK_TABLE" 2>/dev/null; nft -f /tmp/splify2-recheck.nft; } ||
        { logger -t splify2-recheck "the nftables table did not come up"; return 1; }
    procd_open_instance
    # shellcheck disable=SC2046
    procd_set_param command "$RECHECK_BIN" $(recheck_args "$wan")
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

recheck_drop() {
    nft delete table inet "$RECHECK_TABLE" 2>/dev/null
    return 0
}

stop_service() {
    recheck_drop
}

# Сменился WAN (переподключение, другой провайдер на запасном канале) — таблица и движок
# перезапускаются на нём.
service_triggers() {
    procd_add_interface_trigger interface.* wan "/etc/init.d/splify2-recheck" restart
}
