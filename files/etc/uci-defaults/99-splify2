#!/bin/sh
# Настройка пакета объявляется системе здесь, а не заводится на первом обращении.
#
# ЗАЧЕМ. `uci set splify2.main.<ключ>` в несуществующий файл молча ничего не делает: метод
# отвечал бы ok, а значение не сохранялось. rpcd создаёт файл и секцию сам (см. uci_file), и это
# правильная оборона — но не то место.
# Настройка, которую пакет приносит с собой, объявляется через /etc/uci-defaults: тогда
# `uci show splify2` отвечает с первой секунды после установки, а не появляется где-то
# посередине жизни.
#
# ПОЧЕМУ ЗДЕСЬ, А НЕ conffile. Пустой файл настройки как conffile означал бы, что при
# обновлении пакета менеджер спрашивает про него или откатывает изменения человека. Скрипт
# uci-defaults запускается один раз, ничего не перезаписывает и исчезает после успеха.
#
# ЧЕГО ЭТОТ ФАЙЛ НЕ ДЕЛАЕТ: не сохраняет настройку при обновлении прошивки. Общего правила
# «сохраняем /etc/config» не существует: sysupgrade и «Создать архив» собирают список из
# conffiles установленных пакетов, /etc/sysupgrade.conf и /lib/upgrade/keep.d/*, а соседние
# файлы лежат там потому, что их объявили ИХ пакеты. Настройку, заведённую здесь, объявляет
# /lib/upgrade/keep.d/splify2 — у keep.d нет недостатков conffiles, названных выше.
[ -n "${IPKG_INSTROOT}" ] && exit 0

# Идемпотентно: секция заводится, только если её нет. Значений по умолчанию НЕ ставим —
# пустая настройка означает «человек ещё ничего не выбрал», и подставить сюда, например,
# ссылку на манифест значило бы решить за него, откуда брать списки.
uci -q get splify2.main >/dev/null 2>&1 || {
    uci -q set splify2.main=splify2
    uci -q commit splify2
}

# Срок жизни вызова rpcd — 120 секунд вместо стандартных 30.
#
# ЗАЧЕМ. Объект splify2 — скрипт, который rpcd запускает на каждый вызов и УБИВАЕТ по своему
# сроку (`rpcd -t`, по умолчанию 30 с). Половина наших вызовов ходит в сеть: установка движка
# и самого интерфейса, скачивание подписки и списков, каталог стратегий обхода — каждый
# законно живёт дольше половины минуты там, где GitHub отдаёт только с третьего обходного
# пути. Интерфейс ждёт до 120 с (L.env.rpctimeout в view/splify2/home.js), но rpcd обрывал
# скрипт на 30-й секунде: установка доделывалась осиротевшими детьми в фоне, а страница
# показывала «сбой». Хуже того, на живом роутере обрыв совпадал с падением самого rpcd
# (SIGSEGV в журнале ядра), после которого LuCI просит войти заново. Срок должен быть один
# на обеих сторонах, и задаётся он здесь — rpcd читает его из своей настройки при старте.
#
# Не трогаем то, что выставил администратор: больше нашего — оставляем.
_rt="$(uci -q get rpcd.@rpcd[0].timeout)"
case "${_rt:-30}" in ''|*[!0-9]*) _rt=30 ;; esac
if [ "${_rt:-30}" -lt 120 ]; then
    uci -q set rpcd.@rpcd[0].timeout=120
    uci -q commit rpcd
    # Настройка читается при старте; перезапуск — чтобы она подействовала сразу, а не после
    # перезагрузки. В ФОНЕ И С ЗАДЕРЖКОЙ, потому что этот скрипт исполняет postinst, а
    # postinst при обновлении из интерфейса запускает сам rpcd: splify2_install → pkg_install
    # → apk/opkg → postinst → сюда. Перезапусти rpcd здесь же — и ответ метода, который ещё
    # не напечатан, до браузера не доедет: пакет встал, а страница говорит «сбой». У роутера
    # с 1.2.5 срок стоит стандартный (30), то есть ветка срабатывала у каждого, кто обновлялся
    # кнопкой. Тот же приём и по той же причине — в splify2_install (m-engine.sh).
    [ -x /etc/init.d/rpcd ] && ( sleep 2; /etc/init.d/rpcd restart ) >/dev/null 2>&1 &
fi
# Ключи счётчика установок, которого больше нет: согласие (`telemetry`), идентификатор
# (`telemetry_id`) и адрес для стендов (`ping_url`), и его отметка в /tmp.
# `SPLIFY2_TEST_ROOT` — корень для стенда (tests/pkgmatch.sh); на роутере пуст.
_old=""
for _k in telemetry telemetry_id ping_url; do
    uci -q get "splify2.main.$_k" >/dev/null 2>&1 && { uci -q delete "splify2.main.$_k"; _old=1; }
done
_r="${SPLIFY2_TEST_ROOT:-}"
rm -f "$_r/tmp/splify2-ping" 2>/dev/null
[ -n "$_old" ] && uci -q commit splify2
# ПУСТАЯ СПЕКА ПРИ УСТАНОВКЕ — иначе чистый роутер выглядит сломанным.
#
# Движок читает настройку из одного файла и без него не отвечает никому: `steer status`
# печатает «cannot open» и молчит в stdout, `steer diag` — то же самое, а init-скрипт
# говорит «nothing to apply» и оставляет службу без экземпляров. Управляющий слой при этом
# честно пересказывает пустоту, и человек на свежепоставленном роутере читал сразу три
# неправды: «движок не ответил» (движок здесь и работает), «движок не умеет diag — обновите
# steer» (движок свежее некуда) и вечную «Загрузку…» на главной вместо состояния. Снято на
# роутере, сброшенном к заводским (OpenWrt 25.12, mipsel_24kc).
#
# Пустая спека — это НЕ выдуманное состояние, а точная запись того, что есть: выходов нет,
# правил нет, трафик идёт напрямую. С ней движок отвечает как обычно, служба поднимается, а
# пульт говорит «Трафику некуда идти» и ведёт к настройке — то есть правду, с дорогой.
#
# Форма — спека v2 (`version: 2`). Файл создаётся
# ТОЛЬКО когда нет ни spec.json, ни spec.yaml: переустановка пакета поверх настроенного
# роутера не смеет тронуть чужую работу, а две спеки рядом движок отвергает целиком.
#
# ВЫХОД `direct` В НЕЙ ЕСТЬ СРАЗУ. Он ничего не стоит движку (ни метки, ни таблицы) и не
# является настройкой: «пустить напрямую» — это то, что роутер делает и без нас. Правило-
# исключение выражается каналом в этот выход, и пока его в спеке не было, в редакторе правила
# не было и такой цели. Ту же спеку заводит и оборона в rpcd (fast.sh, spec_ensure) — строка
# там одна и та же, потому что и смысл один.
#
# ЯДРО ВЕДЁТ steer-box-connector (podkop, forkop) — спеку не заводим и службу steer не поднимаем:
# она делила бы с его steerd таблицы и метки, а коннектор отказывается работать рядом со службой
# steer, у которой своя спека. Признак тот же, что у box_busy в rpcd.
# Заведение спеки и служба ядра. Начало и конец блока размечены для стенда (tests/pkgmatch.sh):
# корень — тот же шов `_r`, что у блока телеметрии выше, на роутере он пуст.
# >>> пустая спека и служба ядра
SPEC="$_r/etc/steer/spec.json"
if [ ! -s "$SPEC" ] && [ ! -s "$_r/etc/steer/spec.yaml" ] &&
   ! grep -q steer-box-connector "$_r/etc/init.d/sing-box" 2>/dev/null; then
    mkdir -p "$_r/etc/steer" 2>/dev/null
    printf '{"version":2,"outputs":{"direct":{"kind":"direct"}}}\n' > "$SPEC" 2>/dev/null
    # Ядро ставят раньше интерфейса (так и велит установщик), и его демон встаёт без спеки:
    # применять нечего, `steer status` и `steer diag` отвечают «cannot open», а пульт —
    # «ядро не ответило», пока человек не нажал «Применить». `start` для РАБОТАЮЩЕЙ службы —
    # пустой вызов (procd видит тот же экземпляр и ничего не меняет), поэтому ей велено
    # перечитать спеку: reload — запрос демону сверить спеку с применённой, а применённого
    # демон после старта не знает, и первый reload применяет всё, как при старте (steer,
    # src/daemon/recon.c). Не restart: он гасит демона вместе с таблицами и помощниками, а
    # перечитывание не трогает ничего, кроме изменившегося. Снято на демоне в своём сетевом
    # пространстве: поднят без спеки, спека появилась, `status` по-прежнему «cannot open»,
    # `steer reload` — и таблица steer в ядре, и `status` с выходом direct.
    # Службы нет или она не работает — поднимаем, как прежде; движка нет (ставят интерфейс
    # первым) — промолчим, его установка поднимет себя сама. Ту же пару ведёт оборона в rpcd
    # (fast.sh, spec_ensure).
    _si="$_r/etc/init.d/steer"
    if [ -x "$_si" ]; then
        if "$_si" running >/dev/null 2>&1; then
            "$_si" reload >/dev/null 2>&1
        else
            "$_si" start >/dev/null 2>&1
        fi
    fi
fi
# <<< пустая спека и служба ядра


# САМОЛЕЧЕНИЕ СПЕКИ ПРИ УСТАНОВКЕ И ОБНОВЛЕНИИ (spec_heal_zapret и spec_heal_ipv6 в rpcd/m-spec.sh).
# Первое убирает выходы `kind: zapret`, которых ядро больше не принимает (правила идут в direct);
# пакет zapret и его настройку оно не трогает. Второе: выходы-интерфейсы
# без ключа ipv6, записанные прежней панелью, получают `ipv6: nat` (у устройства есть адрес IPv6)
# или `ipv6: off` (адреса нет, клиенты идут по IPv4), и диагностика ядра перестаёт просить masq6 у
# зоны, которую создали мы сами. Тот же шаг делает каждый apply, так что здесь — чтобы исправление
# дошло и до роутера, на котором apply давно не нажимали.
# В ФОНЕ И С ЗАДЕРЖКОЙ, по той же причине, что перезапуск rpcd выше: этот скрипт исполняет
# postinst, который при обновлении из интерфейса запускает сам rpcd, а лечение при изменении
# спеки применяет её — это время, которого ответ метода ждать не должен. Применяется только
# спека, которая уже применялась; ни одного устройства в нашей зоне или ни одного выхода без
# ключа — ничего не происходит.
[ -x /usr/libexec/rpcd/splify2 ] && ( sleep 5; /usr/libexec/rpcd/splify2 call spec_heal </dev/null ) >/dev/null 2>&1 &

exit 0
