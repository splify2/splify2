#!/bin/sh
# ubus-объект splify2 — тонкая обёртка над движком.
#
# Здесь сознательно нет собственной модели каналов. Движок уже умеет отвечать на все
# вопросы про своё состояние, и вторая модель означала бы второе место, которое надо
# держать в согласии с контрактом. Поэтому status/explain отдаются дословно, а spec
# только читается и записывается — с обязательной проверкой компилятором перед тем,
# как файл встанет на место.

# КРУГ ОПРОСА УХОДИТ ОТСЮДА СЛЕДУЮЩЕЙ ЖЕ КОМАНДОЙ (первая — закрытие чужих дескрипторов, см.
# ниже), и это не украшение.
#
# busybox ash разбирает скрипт ЛЕНИВО, команду за командой. Замер на стенде (mipsel 24kc,
# 880 МГц): `exec` в первой строке 250-килобайтного файла стоит 8 мс, а дойти до конца того
# же файла — 128 мс. У этого объекта разбор тела занимает 84 мс, преамбула ещё 24 мс: 126 мс
# постоянной платы за КАЖДЫЙ вызов при том, что сам ответ считается 30-90 мс. Страница
# опрашивала пять методов раз в пять секунд, то есть 630 мс из 1220 уходило на пятикратный
# разбор одного и того же файла.
#
# Поэтому самые частые и самые дешёвые вызовы обслуживаются ДО того, как разобрано что-либо
# ещё: маленький файл рядом (см. его шапку) разбирается за единицы миллисекунд. Условие стоит
# выше всего остального намеренно — любая команда над ним возвращает эту плату обратно.
#
# Здесь только те, у кого своей работы почти нет: круг опроса и чтение спеки. Метод, который
# сам считает сотню миллисекунд, переносить сюда незачем — на его фоне платы не видно, а файл
# превратился бы во второй склад методов.

# ЧУЖИЕ ДЕСКРИПТОРЫ ЗАКРЫВАЮТСЯ ПЕРВЫМ ЖЕ ДЕЛОМ — раньше быстрого пути и всего остального.
#
# rpcd создаёт трубы каждого вызова без O_CLOEXEC, поэтому ребёнок, порождённый для одного
# вызова, наследует трубы ВСЕХ вызовов, которые в эту секунду в полёте (rpcd, exec.c). Само по
# себе это утечка, но у rpcd к ней есть пара: закончив чужой вызов, он закрывает свою сторону
# трубы, а из epoll её не снимает — uloop_fd_delete зовётся уже по дескриптору −1 и молча
# отказывает. Пока трубу держит кто-то ещё, регистрация живёт и указывает на освобождённую
# память; когда труба наконец закрывается, epoll приносит EPOLLHUP, и rpcd разыменовывает
# мусор — SIGSEGV, после которого LuCI просит войти заново. На живом роутере это выглядело как
# падение rpcd во время фоновой проверки стратегий: её процесс, запущенный отсюда, держал трубы
# каждого опроса страницы, прошедшего за время проверки.
#
# Исправление в самом rpcd — openwrt/rpcd#41 (uloop_fd_delete до close и pipe2 с O_CLOEXEC);
# пока оно не во всех прошивках, держателем чужих труб не должны быть мы. Закрывается всё, что
# старше 2, сразу после запуска — и для самого скрипта (долгая установка пакета перестаёт
# переживать соседний опрос с его трубами в руках), и для всего, что он запустит в фоне: ни
# `start-stop-daemon -b`, ни `&` унаследованного не закрывают (проверено на роутере).
#
# Что здесь важно и неочевидно:
#   - Номера труб у rpcd двузначные (на роутере с LuCI — 14…18), и busybox ash их закрывает.
#     dash (стенды, runner GitHub) двузначный номер в перенаправлении НЕ ПОНИМАЕТ — и это не
#     отказ команды, а синтаксическая ошибка, которая внутри eval у неинтерактивной оболочки
#     фатальна: объект умирал молча, до первой печати, а `2>/dev/null` прятал и причину.
#     Прежняя редакция ждала «ругается» и глушила ругань. Стрельнуло на runner'е GitHub, где у
#     процесса оказался унаследованный дескриптор 142: все 483 проверки покраснели одним махом.
#     Поэтому умение оболочки пробуется один раз, в подоболочке (её смерть нас не трогает), и
#     там, где его нет, дескрипторы старше 9 не трогаются вовсе — их там и не бывает по делу.
#   - Дескриптор, через который оболочка читает ЭТОТ файл, трогать нельзя — обрыв разбора.
#     Он узнаётся сравнением с самим файлом (`-ef`), а не по номеру: ash даёт ему 10 или
#     выше, dash — 10, и оба вправе передумать.
#   - Стоит это единицы микросекунд: перебор — glob по /proc без запуска процессов, а в
#     обычном вызове посторонних дескрипторов нет вовсе.
if ( exec 3>/dev/null; eval 'exec 10>&3'; eval 'exec 10>&-' ) 2>/dev/null; then _fd_wide=1; else _fd_wide=0; fi
for _fd in /proc/$$/fd/*; do
    _fd="${_fd##*/}"
    [ "$_fd" -gt 2 ] 2>/dev/null || continue
    [ "$_fd" -le 9 ] || [ "$_fd_wide" = 1 ] || continue
    [ "/proc/$$/fd/$_fd" -ef "$0" ] && continue
    eval "exec $_fd>&-" 2>/dev/null
done
unset _fd _fd_wide

case "${1:-}:${2:-}" in
    call:live)        . "${FAST_SH:-/usr/lib/splify2/fast.sh}"; fast_live;        exit 0 ;;
    call:spec_get)    . "${FAST_SH:-/usr/lib/splify2/fast.sh}"; fast_spec_get;    exit $? ;;
    call:applied_get) . "${FAST_SH:-/usr/lib/splify2/fast.sh}"; fast_applied_get; exit 0 ;;
esac

# JSHN_SH — единственный шов, заведённый исключительно ради стенда. Остальные пути ниже
# переопределяемы по той же причине, но у них есть и второе применение (второй роутер,
# нестандартный префикс); у этого — нет. rpcd запускает объект с чистым окружением, так
# что на роутере ветка `:-` не выбирается никогда. Без шва tests/rpcdmatch.sh не может
# запустить настоящий скрипт: libubox на машине разработчика нет, а подменить путь,
# зашитый в `.`, нечем.
# Окружение (швы, пути, общие функции) — файл рядом с остальными библиотеками: его же подключают
# программы плагинов (lib.sh). Путь выводится из места самого диспетчера: на роутере это
# /usr/libexec/rpcd/splify2 -> /usr/lib/splify2/env.sh, в стенде — то же внутри дерева репозитория.
ENV_SH="${ENV_SH:-${0%/*}/../../lib/splify2/env.sh}"
. "$ENV_SH"

case "$1" in
list)
    json_init
    json_add_object status; json_close_object
    # Круг опроса одним вызовом. `diag` — по просьбе: проверки движка стоят вдвое дороже
    # состояния и меняются реже, поэтому спрашивает их страница, а не мы решаем за неё.
    #
    # `fast` — по той же логике и с тем же доводом: движок помнит свой последний полный ответ
    # и умеет отдать запомненное немедленно, а решать, когда память годится вместо измерения,
    # обязан спрашивающий. Страница просит её ровно на первом круге, чтобы нарисовать экран
    # без ожидания, и тут же идёт вторым кругом за свежим. Ответ на быстрый круг несёт
    # `status.cached` и `status.at` — по ним видно, что это память и какой она давности.
    json_add_object live; json_add_boolean diag; json_add_boolean fast; json_close_object
    json_add_object spec_get; json_close_object
    json_add_object applied_get; json_close_object
    json_add_object spec_set; json_add_string spec; json_add_string rev; json_close_object
    json_add_object apply; json_close_object
    json_add_object spec_heal; json_close_object
    json_add_object explain; json_add_string address; json_close_object
    json_add_object lists; json_close_object
    # kind объявлен обязательно, хотя реализация его читала и раньше: rpcd отсекает
    # поля, которых нет в сигнатуре, и без него доменный запрос уходил бы в фолбэк
    # manifest_file, где адресные категории проверяются ПЕРВЫМИ. У издателя `news` и
    # `hodca` есть в обоих пространствах имён, так что доменный запрос скачивал бы
    # адресный файл в news.lst — при том что правило ждёт domains/news.lst. Ответ при
    # этом ok, а падает потом apply, далеко от причины. Это дословно I-011, для
    # list_remove ниже сигнатуру расширили, а здесь забыли.
    json_add_object list_fetch; json_add_string id; json_add_string kind; json_close_object
    json_add_object devices; json_close_object
    # Сети клиентов — противоположный вопрос к `devices`: не куда выпустить трафик, а
    # откуда он приходит (splify2#16).
    json_add_object client_nets; json_close_object
    json_add_object local_lists; json_close_object
    # Каталог ВТОРОГО издателя (itdoginfo/allow-domains) и то, что из него лежит на диске.
    # Входа нет: метод только читает — таблицу сервисов из описания источника, тег из uci и
    # сами файлы. В сеть он не ходит НИКОГДА, потому что его зовёт открытие вкладки, а не
    # нажатие; качает по-прежнему list_fetch, по id с приставкой «itdog:».
    #
    # Отдельным методом, а не полем в `lists`: тот отдаёт манифест первого издателя дословно,
    # и вклейка своих полей в чужой JSON стоила бы разбора и пересборки манифеста в shell на
    # каждом открытии каталога.
    json_add_object allow_domains; json_close_object
    json_add_object lists_update; json_close_object
    json_add_object list_remove
        json_add_string id; json_add_string kind; json_add_string name
    json_close_object
    json_add_object list_put
        json_add_string name; json_add_string kind
        json_add_string text; json_add_string url; json_add_boolean append
        # Откуда список и как он назывался у человека. Нужно правке: у файла меняют файл,
        # у ссылки — ссылку, у набранного руками — сами записи (см. custom_meta_path).
        json_add_string source; json_add_string filename
    json_close_object
    # Чем список стал на диске и откуда он взялся — для правки. Отдельным методом, а не
    # полем local_lists: тот считается awk-ом по всему каталогу и зовётся на каждое открытие
    # настроек, а происхождение нужно только своим спискам и только когда их правят.
    json_add_object list_custom; json_close_object
    # Записи списка обратно, порциями: редактор набранного руками должен показать то, что
    # лежит на роутере, а не пустое поле.
    json_add_object list_get
        json_add_string name; json_add_string kind; json_add_int offset
    json_close_object
    # Что лежит в списке (только чтение, каталог списков): `q` — поиск по записям.
    json_add_object list_peek
        json_add_string path; json_add_string q
    json_close_object
    # Свой список из набора sing-box (.srs): base64 порциями (append, final) или ссылкой.
    json_add_object list_srs_put
        json_add_string name; json_add_string url; json_add_string data
        json_add_boolean append; json_add_boolean final; json_add_string filename
    json_close_object
    json_add_object engine; json_close_object
    # `name` — какая из подписок. Поля нет — первая (main), и это же значение приходит от
    # интерфейсов, которые про несколько подписок ещё не знают.
    # `links` — ссылки узлов отдельным полем: прокси http(s):// по виду не отличить от адреса
    # подписки, и в `url` такая ссылка скачивалась бы как подписка.
    json_add_object sub_set
        json_add_string url; json_add_string name; json_add_string title; json_add_string links
    json_close_object
    json_add_object sub_info; json_add_string name; json_close_object
    json_add_object sub_list; json_close_object
    json_add_object sub_del; json_add_string name; json_close_object
    # Своё название подписки; пустое снимает его (R-115).
    json_add_object sub_rename; json_add_string name; json_add_string title; json_close_object
    # Ссылку метод берёт из uci — второй источник той же ссылки означал бы, что остаток
    # можно спросить у панели, которой роутер не пользуется.
    json_add_object sub_quota; json_add_string name; json_close_object
    # Автообновление подписки: интервал в минутах у каждой свой, ноль — не обновлять.
    json_add_object sub_auto; json_add_string name; json_add_int minutes; json_close_object
    # Обновить по сохранённой ссылке. Зовёт расписание; человек нажимает «Обновить», и тогда
    # работает sub_set — у него на входе ссылка.
    json_add_object sub_refresh; json_add_string name; json_close_object
    # Архив настроек. offset/append/final — куски: ubus не резиновый, и целиком архив в
    # одно сообщение не влезает (тот же довод, что у порций list_put).
    #
    # append и final объявлены БУЛЕВЫМИ, значит и приезжать обязаны булевыми: blobmsg_parse
    # молча отбрасывает атрибут, тип которого не совпал с политикой, и число 1 здесь дошло бы
    # до скрипта как отсутствующее поле — то есть каждый кусок замещал бы предыдущий, а
    # последний не запускал бы восстановление вовсе. Ровно это уже случилось с list_put.
    json_add_object backup_get; json_add_int offset; json_close_object
    json_add_object backup_put
        json_add_string text; json_add_boolean append; json_add_boolean final
    json_close_object
    json_add_object dev_stats; json_close_object
    json_add_object diag; json_close_object
    # Отчёт для поддержки: один готовый к вставке в чат текст. Входа нет — состав отчёта
    # решает бэкенд, а не вызывающий: набор полей и есть договорённость с помогающим, и
    # право выбрать половину из них означало бы отчёты, по которым нельзя задать один и
    # тот же вопрос.
    json_add_object support_report; json_close_object
    json_add_object net_info; json_close_object
    json_add_object outbound_probe; json_add_string output; json_close_object
    # Проверка серверов DNS с роутера (`steer dns-probe`): адрес сервера, как в dns.upstreams, и по
    # желанию «=адрес,адрес» — минуя bootstrap. Ответ ядра — дословно.
    json_add_object dns_probe; json_add_array urls; json_close_array; json_close_object
    json_add_object outbound_geo
        json_add_string output; json_add_boolean fresh
    json_close_object
    json_add_object leases; json_close_object
    json_add_object engine_state; json_close_object
    json_add_object ui_get; json_close_object
    json_add_object ui_set; json_add_string state; json_close_object
    json_add_object xsteer_state; json_close_object
    json_add_object xsteer_link
        json_add_string iface; json_add_string link
    json_close_object
    json_add_object xsteer_link_put
        json_add_string iface; json_add_string link
    json_close_object
    json_add_object lists_source; json_close_object
    json_add_object lists_source_set; json_add_string url; json_close_object
    json_add_object fetch_mode; json_close_object
    json_add_object fetch_mode_set; json_add_string mode; json_close_object
    # `sub` — путь к файлу подписки: узлы подписки, на которую ещё не заведён ни один выход.
    # Одно из двух: либо имя выхода, либо файл. `insecure` — только с файлом: перечень и проверка,
    # как у выхода с «не проверять сертификат узла» (узлы TLS с allowInsecure входят, номера те же).
    json_add_object vless_nodes; json_add_string output; json_add_string sub; json_add_boolean insecure; json_close_object
    json_add_object vless_probe
        json_add_string output; json_add_string sub; json_add_int node; json_add_boolean insecure
    json_close_object
    # Те же два вызова для выхода `protocol: hysteria2` (пакет steer-hysteria2): формат узла один.
    json_add_object hysteria2_nodes; json_add_string output; json_add_string sub; json_close_object
    json_add_object hysteria2_probe
        json_add_string output; json_add_string sub; json_add_int node
    json_close_object
    # И для выходов прокси steer-proxy (trojan, shadowsocks, socks, http, vmess). У файла подписки
    # номера узлов идут сквозь все протоколы прокси, у выхода — внутри своего протокола; ответ
    # ядра отдаётся дословно, поле `type` каждого узла называет протокол.
    json_add_object proxy_nodes; json_add_string output; json_add_string sub; json_add_boolean insecure; json_close_object
    json_add_object proxy_probe
        json_add_string output; json_add_string sub; json_add_int node; json_add_boolean insecure
    json_close_object
    # Состояние движка 2.0: журнал имён резолвера (апстримы, кэш), соединения, живое состояние
    # помощников выхода и выбор члена группы `pick: manual`.
    json_add_object dns_log; json_close_object
    json_add_object conns; json_close_object
    json_add_object helper; json_add_string output; json_close_object
    json_add_object purge; json_add_boolean plan; json_add_boolean keep_config; json_close_object
    json_add_object engine_stop; json_close_object
    json_add_object engine_start; json_close_object
    json_add_object splify2_versions; json_close_object
    json_add_object splify2_install; json_add_string version; json_close_object
    json_add_object steer_versions; json_close_object
    json_add_object steer_install
        json_add_string version; json_add_string modules
    json_close_object
    # Модули ядра 2.0: перечень с состоянием и установка или снятие одного модуля.
    json_add_object steer_modules; json_close_object
    # ReCheck — обход DPI на прямом трафике (служба splify2-recheck, движок — пакет recheck):
    # состояние с изученным и настройки. Поле, которого в recheck_set нет, остаётся прежним.
    json_add_object recheck_info; json_close_object
    json_add_object recheck_set
        json_add_boolean enabled; json_add_string interface; json_add_boolean persist
        json_add_boolean watch_active; json_add_array resources; json_close_array
        json_add_boolean epoch_bump; json_add_boolean forget
    json_close_object
    json_add_object steer_module_add; json_add_string module; json_close_object
    json_add_object steer_module_del; json_add_string module; json_close_object
    # Плагины: обёртка над менеджером ядра (rpcd/m-plugin.sh). У plugin_call поле params — объект
    # произвольной формы: в сигнатуре его нет, rpcd отдаёт обработчику сообщение целиком.
    json_add_object plugins_list; json_close_object
    json_add_object plugins_search; json_add_string query; json_close_object
    json_add_object repos_list; json_close_object
    json_add_object plugin_status; json_add_string id; json_close_object
    json_add_object plugin_job; json_add_string id; json_close_object
    json_add_object plugin_install; json_add_string id; json_add_string version; json_close_object
    json_add_object plugin_update; json_add_string id; json_close_object
    json_add_object plugin_remove; json_add_string id; json_add_boolean force; json_add_boolean purge; json_close_object
    json_add_object plugin_enable; json_add_string id; json_close_object
    json_add_object plugin_disable; json_add_string id; json_close_object
    json_add_object plugin_autoupdate; json_add_string id; json_add_boolean enabled; json_close_object
    json_add_object repo_key; json_add_string key; json_close_object
    json_add_object repo_add; json_add_string url; json_add_string key; json_add_string key_id; json_close_object
    json_add_object repo_del; json_add_string name; json_close_object
    json_add_object plugin_call; json_add_string id; json_add_string method; json_close_object
    # Каркас на классическом LuCI JS (view/splify2/core): схема ключей спеки из ядра, проверка спеки без записи,
    # настройки каркаса, словари языка от плагинов, настройки плагина по его схеме. values у
    # plugin_settings_set — объект: в сигнатуре его нет (как params у plugin_call).
    json_add_object spec_schema; json_close_object
    json_add_object spec_check; json_add_string spec; json_close_object
    json_add_object spec_yaml; json_close_object
    json_add_object prefs_get; json_close_object
    json_add_object prefs_set; json_add_string interface; json_close_object
    json_add_object i18n_get; json_add_string lang; json_close_object
    json_add_object plugin_settings_get; json_add_string id; json_close_object
    json_add_object plugin_settings_set; json_add_string id; json_close_object
    # Новые имена на объекте splify2 от плагинов (`splify2.methods.alias` без имени у каркаса): их знает реестр.
    # Вынесенные из каркаса методы (backup_get, lists …) уже перечислены выше — псевдонимом они остаются теми же.
    if [ -z "${SPLIFY2_NO_EXT:-}" ]; then
        if need_ext; then
            for _ext_n in $(ext_list_names); do json_add_object "$_ext_n"; json_close_object; done
        fi
    fi
    json_dump
    ;;
call)
    # РАСШИРЕНИЯ КАРКАСА (splify2-api): переопределения методов и их псевдонимы берутся из реестра плагинов — файла,
    # который пересобирает plugin_sync. Метод без записи в реестре идёт прежним путём; цена проверки — чтение
    # небольшого файла встроенной командой `read`, без запуска процессов. final-методы (plugin_*, repo_* …)
    # в реестр не попадают никогда. SPLIFY2_NO_EXT=1 ставит сам реестр, когда зовёт обработчик каркаса под обёрткой.
    case "$2" in
        plugin_*|plugins_*|repo_*|repos_*|prefs_*) ;;
        *)
            if [ -z "${SPLIFY2_NO_EXT:-}" ]; then
                _ext_reg="${EXT_REG:-/var/run/splify2/ext.reg}"
                _ext_state="${PLUGIN_STATE:-/etc/steer/plugins/state.json}"
                _ext_safef="${EXT_SAFE_FILE:-/etc/splify2/safe}"
                _ext_stale=0
                [ -f "$_ext_reg" ] || _ext_stale=1
                [ "$_ext_state" -nt "$_ext_reg" ] && _ext_stale=1
                if [ -e "$_ext_safef" ]; then [ -e "$_ext_reg.safe" ] || _ext_stale=1
                else [ -e "$_ext_reg.safe" ] && _ext_stale=1; fi
                if [ "$_ext_stale" = 1 ] && need_ext; then ext_rebuild; fi
                _ext_tab='	'
                _ext_hit=0
                if [ -f "$_ext_reg" ]; then
                    while IFS="$_ext_tab" read -r _ext_k _ext_a _ext_rest; do
                        [ "$_ext_k" = m ] && [ "$_ext_a" = "$2" ] && { _ext_hit=1; break; }
                    done < "$_ext_reg"
                fi
                # Диспетчер вне цикла: вход запроса — стандартный ввод, а в цикле он занят файлом реестра.
                if [ "$_ext_hit" = 1 ] && need_ext; then
                    ext_dispatch "$2"
                    exit 0
                fi
            fi ;;
    esac
    # МЕТОД → ГРУППА. Разбирается только файл группы (плюс common.sh): см. шапку файлов в
    # /usr/lib/splify2/rpcd. Метод, которого нет ни в одной группе, — отказ здесь же, до
    # чтения чего бы то ни было.
    case "$2" in
        status|diag|dev_stats|net_info|devices|client_nets|leases|engine_state|outbound_probe|explain|xsteer_state|vless_nodes|vless_probe|hysteria2_nodes|hysteria2_probe|proxy_nodes|proxy_probe|dns_log|dns_probe|conns|helper|support_report|spec_schema|spec_yaml) _grp=state ;;
        spec_set|spec_check|apply|spec_heal) _grp=spec ;;
        # Методы, вынесенные в плагины (plugins/): без плагина — отказ «нужен плагин X», с плагином их берёт реестр
        # расширений выше как псевдонимы (methods.tsv, колонка moved).
        lists|list_fetch|lists_update|list_put|list_remove|list_custom|list_get|list_peek|list_srs_put|local_lists|allow_domains|fetch_mode|fetch_mode_set|\
        lists_source|lists_source_set|backup_get|backup_put|sub_quota|sub_auto|sub_rename|outbound_geo|steer_versions|splify2_versions|splify2_install|steer_install) _grp=moved ;;
        engine|engine_stop|engine_start|ui_get|ui_set|\
        steer_modules|steer_module_add|steer_module_del|purge|prefs_get|prefs_set|i18n_get) _grp=engine ;;
        sub_set|sub_info|sub_list|sub_del|sub_refresh) _grp=sub ;;
        xsteer_link|xsteer_link_put) _grp=xsteer ;;
        recheck_info|recheck_set) _grp=recheck ;;
        plugins_list|plugins_search|repos_list|plugin_status|plugin_job|plugin_install|plugin_update|plugin_remove|\
        plugin_enable|plugin_disable|plugin_autoupdate|repo_key|repo_add|repo_del|plugin_call|plugin_settings_get|plugin_settings_set) _grp=plugin ;;
        *) fail_code req.unknown_method "Unknown method" ;;
    esac
    # ЗАМОК НА МЕТОДЫ, КОТОРЫЕ ЧИТАЮТ, МЕНЯЮТ И ЗАМЕНЯЮТ ОБЩИЙ ФАЙЛ. Каждый вызов rpcd — свой
    # процесс, и ручное «Применить» шло параллельно с плановым обновлением подписки или лечением
    # после установки: оба читали спеку, учёт зон фаервола или файл подписки, оба писали своё, и
    # выигрывал тот, кто заменил файл последним (I-546, I-473). Одна блокировка на спеку, подписки
    # и архив — у них общие файлы и общий учёт зон; установка пакетов — своя (долгая, и спеку
    # ей держать незачем).
    case "$2" in
        spec_set|apply|spec_heal|sub_set|sub_del|sub_refresh) call_lock state ;;
        steer_module_add|steer_module_del) call_lock install ;;
    esac
    # Где спека и как её читать (spec.yaml ядра 2.1 или spec.json): читать — `spec_json`, писать —
    # `spec_put`. Файл — /usr/lib/splify2/spec.sh, рядом с каталогом групп.
    . "${SPEC_SH:-${RPCD_LIB%/rpcd}/spec.sh}"
    . "$RPCD_LIB/common.sh"
    . "$RPCD_LIB/m-$_grp.sh"
    ;;
esac
