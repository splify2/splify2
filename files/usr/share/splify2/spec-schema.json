     "default": [
      "br-lan"
     ],
     "title": "Devices"
    },
    "addr": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "title": "Client addresses"
    }
   },
   "additionalProperties": false,
   "title": "LAN"
  },
  "clients": {
   "type": "object",
   "x-map": {
    "type": "object",
    "properties": {
     "addr": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "title": "Addresses"
     },
     "mac": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$"
