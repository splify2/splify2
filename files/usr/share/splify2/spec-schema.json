  },
  "outputs": {
   "type": "object",
   "x-map": {
    "type": "object",
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "direct",
       "block",
       "interface",
       "tunnel",
       "xsteer",
       "awg",
       "tgws",
       "group",
       "warp"
