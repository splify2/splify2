#!/bin/sh
# Программа плагина lists-catalog: $1 — метод, параметры — одна строка JSON в stdin, ответ — JSON в stdout.
#
# Окружение даёт библиотека splify2-api, код методов — lib/lists.sh (бывший m-lists.sh каркаса): он разбирает `$2`
# как имя метода, поэтому позиционные аргументы выставляются так, как их видел диспетчер. Имена методов плагина
# совпадают с прежними именами на объекте splify2.
. "${SPLIFY2_LIB:?программа запускается хостом splify2 (нет SPLIFY2_LIB)}"

case "${1:-}" in
    lists|list_fetch|lists_update|list_put|list_remove|list_custom|list_get|list_peek|list_srs_put|local_lists|\
    allow_domains|fetch_mode|fetch_mode_set|lists_source|lists_source_set) set -- call "$1" ;;
    *) echo "нет такого метода: ${1:-}" >&2; exit 2 ;;
esac
. "${STEER_PLUGIN_DIR:?}/lib/lists.sh"
