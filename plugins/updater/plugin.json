{
  "schema": 1,
  "id": "updater",
  "version": "1.0.0",
  "name": "Updater",
  "description": "Versions and installation of the steer core and of splify2 itself from the releases, with a periodic check",
  "homepage": "https://github.com/splify2/splify2",
  "compat": {
    "splify2-api": "^1.0"
  },
  "arch": "all",
  "permissions": [
    "splify2.hooks"
  ],
  "i18n": {
    "languages": [
      "ru",
      "en"
    ]
  },
  "rpc": {
    "prog": "bin/updater",
    "methods": {
      "steer_versions": {
        "access": "read",
        "timeout_s": 120
      },
      "splify2_versions": {
        "access": "read",
        "timeout_s": 120
      },
      "steer_install": {
        "access": "write",
        "timeout_s": 600
      },
      "splify2_install": {
        "access": "write",
        "timeout_s": 600
      },
      "update_status": {
        "access": "read",
        "timeout_s": 30
      },
      "update_check": {
        "access": "write",
        "timeout_s": 120
      }
    }
  },
  "splify2": {
    "hooks": {
      "backup_sections": {
        "prog": "hooks/backup",
        "timeout_s": 30
      },
      "support_report": {
        "prog": "hooks/support"
      },
      "purge": {
        "prog": "hooks/purge"
      }
    },
    "tasks": [
      {
        "name": "check-updates",
        "every": "6h",
        "prog": "bin/check-updates",
        "timeout_s": 300
      }
    ],
    "methods": {
      "alias": {
        "steer_versions": "steer_versions",
        "splify2_versions": "splify2_versions",
        "steer_install": "steer_install",
        "splify2_install": "splify2_install",
        "update_status": "update_status",
        "update_check": "update_check"
      }
    },
    "settings": {
      "schema": "settings.schema.json"
    }
  }
}
