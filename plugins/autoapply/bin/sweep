#!/bin/sh
# Задача sweep (раз в пять минут): применить сохранённое и не применённое — правили в другом окне, ядро было недоступно,
# роутер перезагрузился в паузе. Отвергнутое ядром не повторяется, пока спека не изменится; «не состоялось» (ядро занято
# коннектором, остановил хук) повторяется.
. "${STEER_PLUGIN_DIR:?программа запускается хостом splify2 (нет STEER_PLUGIN_DIR)}/lib/base.sh"
is_on enabled || exit 0
is_on sweep || exit 0
[ -e "$PENDING" ] && exit 0                 # пауза идёт, применит worker
unapplied || exit 0
if [ -s "$FAILED" ] && [ "$(cat "$FAILED")" = "$(spec_sum)" ]; then exit 0; fi
do_apply sweep
exit 0
